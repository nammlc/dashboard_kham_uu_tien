# ── Bảo mật ───────────────────────────────────────────────
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-kho-doan

# ── Google OAuth (tạo tại console.cloud.google.com) ────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── Danh sách email được phép đăng nhập ────────────────────
# Phân cách bằng dấu phẩy, không có khoảng trắng
ALLOWED_EMAILS=admin@bvtd.vn,bskyyyy@gmail.com

# ── Mật khẩu dùng cho đăng nhập bằng email ─────────────────
ADMIN_PASSWORD=mat-khau-manh
# Chỉ dùng để TẠO tài khoản lần đầu (khi bảng admin_users còn trống). Sau đó tài khoản + mật khẩu (đã băm) nằm trong
# cơ sở dữ liệu; đổi / thêm / tắt tài khoản bằng: flask --app app admin-passwd|admin-add|admin-disable ...

# ── Cơ sở dữ liệu PostgreSQL (bảng admin_users + access_log) ──────────────────────
# Coolify: tạo database PostgreSQL rồi dán "Postgres URL (internal)" vào đây. Mật khẩu có ký tự đặc biệt phải mã hoá URL (@ → %40)
DATABASE_URL=postgresql://bvtd:mat-khau-db@ten-service-postgres:5432/bvtd
# LOG_RETENTION_DAYS=90
# SESSION_IDLE_MINUTES=15

# ── Google Sheets ───────────────────────────────────────────
SHEET_ID=1EYiRA3ar41aue8DlbWA7JTKoLL0M2tiLTcZINhdMfTs
SHEET_NAME=Câu trả lời biểu mẫu 1

# ── GCP Service Account ─────────────────────────────────────
# Dán toàn bộ nội dung file credentials.json vào đây (1 dòng)
GCP_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Trang đăng ký khám công khai (/dang-ky): 0 = tạm đóng ──
REG_ENABLED=1

# ── Môi trường ──────────────────────────────────────────────
FLASK_ENV=production

# ── Tách tên miền bệnh nhân / admin (tuỳ chọn) ──────────────────────────────
# Tên miền dành cho bệnh nhân: mở trang chủ "/" sẽ tự chuyển sang /dang-ky
# PATIENT_HOST=dangky.example.com
# Đặt 1 → tên miền bệnh nhân CHỈ phục vụ /dang-ky, /dang-ky/xong, /static (trang admin chỉ vào bằng tên miền admin)
# PATIENT_HOST_PUBLIC_ONLY=1
